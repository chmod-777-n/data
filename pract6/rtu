Ему#include <stdio.h>

int main(void) {
    double sales;
    double bonus = 0.0;
    double total_bonus = 0.0;

    printf("Введите объем продаж: ");
    scanf("%lf", &sales);

    // Ступенчатая тарифная сетка через полную цепочку if...else if...else
    if (sales <= 20000) {
        bonus = 0.02; // 2%
    } 
    else if (sales > 20000 && sales <= 100000) {
        bonus = 0.03; // 3%
    } 
    else {
        bonus = 0.05; // 5% свыше 100000
    }

    // Вычисляем итоговую сумму бонуса
    total_bonus = sales * bonus;

    // Вывод результатов (исходная величина, разбивка по ступеням, итог)
    printf("\nИсходная сумма продаж: %.2f\n", sales);
    printf("Тарифная ступень: ");
    if (bonus == 0.02) {
        printf("до 20000 (2%%)\n");
    } else if (bonus == 0.03) {
        printf("от 20000 до 100000 (3%%)\n");
    } else {
        printf("свыше 100000 (5%%)\n");
    }
    printf("Итоговый бонус: %.2f\n", total_bonus);

    /* 
     * КОММЕНТАРИЙ ДЛЯ ОТЧЕТА:
     * Почему double, а не float?
     * double имеет более высокую точность (15-17 значащих цифр против 6-7 у float).
     * В денежных расчетах недопустимы потери точности, так как ошибки округления 
     * приведут к неправильному расчету бонусов и итоговых сумм.
     */
    return 0;
} нужны ОБА условия истинными.

Если первое условие — ложь (0), то каким бы ни было второе, результат всё равно будет ложь. Поэтому компьютер останавливается и не проверяет второе условие
Ему достаточно, чтобы ХОТЯ БЫ ОДНО условие было истинным.

