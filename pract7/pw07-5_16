#include <stdio.h>

long long perrin_recursive(int n) {
    if (n == 0) return 3;
    if (n == 1) return 0;
    if (n == 2) return 2;
    
    return perrin_recursive(n - 2) + perrin_recursive(n - 3);
}
long long perrin_iterative(int n) {
    if (n == 0) return 3;
    if (n == 1) return 0;
    if (n == 2) return 2;
    
    long long p0 = 3; 
    long long p1 = 0; 
    long long p2 = 2; 
    long long pn = 0;
    
    for (int i = 3; i <= n; i++) {
        pn = p1 + p0;
        
        p0 = p1;
        p1 = p2;
        p2 = pn;
    }
    
    return pn;
}
int main() {
    int n;
    
    printf("Введите номер числа Перрина (n >= 0): ");
    if (scanf("%d", &n) != 1 || n < 0) {
        printf("Ошибка ввода! Введите неотрицательное целое число.\n");
        return 1;
    }
    long long res_rec = perrin_recursive(n);
    long long res_ite = perrin_iterative(n);

    printf("Результаты для n = %d\n", n);
    printf("Рекурсивно:  %lld\n", res_rec);
    printf("Итеративно:  %lld\n", res_ite);

    if (res_rec == res_ite) {
        printf("Результаты совпадают!\n");
    } else {
        printf("Ошибка: результаты не совпадают!\n");
    }

    return 0;
}
