#include <stdio.h>

// Пользовательская функция, принимающая указатели на переменные
void multiply_and_divide(double *a, double *b) {
    // 1. Сохраняем исходные значения, чтобы не испортить их в процессе
    double original_a = *a;
    double original_b = *b;

    // 2. Выполняем вычисления и записываем новые значения по адресам (*a и *b)
    *a = original_a * original_b; // Первой переменной — произведение
    *b = original_a / original_b; // Второй переменной — частное
}

int main() {
    double x, y;

    // Ввод значений
    printf("Введите первое число (x): ");
    if (scanf("%lf", &x) != 1) {
        printf("Ошибка ввода!\n");
        return 1;
    }

    printf("Введите второе число (y): ");
    if (scanf("%lf", &y) != 1) {
        printf("Ошибка ввода!\n");
        return 1;
    }

    // Вывод исходных значений
    printf("\n--- Исходные значения ---\n");
    printf("x = %.2f, y = %.2f\n", x, y);

    // Вызов функции. Передаем АДРЕСА переменных с помощью оператора '&'
    // Проверяем деление на ноль (если y == 0)
    if (y != 0) {
        multiply_and_divide(&x, &y);
        
        // Вывод измененных значений
        printf("\n--- Измененные значения ---\n");
        printf("x (произведение) = %.2f\n", x);
        printf("y (частное)      = %.2f\n", y);
    } else {
        printf("\nОшибка: Деление на ноль невозможно (y = 0)!\n");
    }

    return 0;
}
