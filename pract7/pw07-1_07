#include <stdio.h>

int main(void) {
    int ch;

    printf("Введите текст (для завершения нажмите Ctrl+D):\n");

    // Цикл работает, пока не достигнут конец файла (EOF)
    while ((ch = getchar()) != EOF) {
        
        // Если текущий символ — это табуляция (\t)
        if (ch == '\t') {
            // Вместо одного символа табуляции выводим три пробела
            printf("   "); 
        } else {
            // Все остальные символы выводим без изменений
            putchar(ch);
        }
    }

    return 0;
}
