#include <stdio.h>
#include <ctype.h>

int main() {
    int ch;
    int count_multiple_11 = 0; // Счетчик символов, кратных 11
    int total_chars = 0;       // Общий счетчик обработанных символов

    // Считываем символы до конца файла (EOF)
    while ((ch = getchar()) != EOF) {
        total_chars++; // Увеличиваем общий счетчик

        // Проверяем, кратен ли ASCII-код числу 11
        if (ch % 11 == 0) {
            count_multiple_11++;
        }
    }

    // Выводим статистику
    printf("\n--- Статистика ---\n");
    printf("Количество символов, чей ASCII-код кратен 11: %d\n", count_multiple_11);
    printf("Общее количество обработанных символов: %d\n", total_chars);

    return 0;
}
• Разница между IsLetter и isalpha: В Си isalpha() по умолчанию работает только с латинским алфавитом (если не настроена специальная однобайтовая локаль). 
В языках с поддержкой Unicode функция IsLetter() проверяет
принадлежность символа к буквам любого алфавита мира (кириллица, иероглифы, греческий и т.д.).
• Разница между IsDigit и IsNumber (в Unicode-языках):
	• IsDigit возвращает истину только для стандартных десятичных цифр (0–9 и их аналогов в других системах письма, например арабско-индийских цифр).
	• IsNumber включает в себя всё, что проверяет IsDigit, а также другие числовые символы Юникода: простые дроби (½, ¾), надстрочные/подстрочные 
степени (², ³) и римские цифры (Ⅰ, Ⅴ).
