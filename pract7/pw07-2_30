#include <stdio.h>
#include <ctype.h>

int main() {
    int ch;
    int count_11 = 0; 
    int total_chars = 0;      

    printf("Введите текст (Ctrl+D - завершить):\n");

    while ((ch = getchar()) != EOF) {
        total_chars++; 

        if (ch % 11 == 0) {
            count_11++;
        }
    }

    printf("Количество символов, чей ASCII-код кратен 11: %d\n", count_11);
    printf("Общее количество обработанных символов: %d\n", total_chars);

    return 0;
}
