#include <stdio.h>

// ==========================================
// 1. РЕКУРСИВНЫЙ СПОСОБ
// ==========================================
// Функция вызывает саму себя до тех пор, пока не достигнет базовых случаев (0, 1, 2)
long long perrin_recursive(int n) {
    if (n == 0) return 3;
    if (n == 1) return 0;
    if (n == 2) return 2;
    
    return perrin_recursive(n - 2) + perrin_recursive(n - 3);
}

// ==========================================
// 2. ИТЕРАТИВНЫЙ СПОСОБ (с помощью цикла)
// ==========================================
// Используем цикл и храним только последние 3 значения
long long perrin_iterative(int n) {
    if (n == 0) return 3;
    if (n == 1) return 0;
    if (n == 2) return 2;
    
    long long p0 = 3; // P(0)
    long long p1 = 0; // P(1)
    long long p2 = 2; // P(2)
    long long pn = 0;
    
    for (int i = 3; i <= n; i++) {
        pn = p1 + p0; // P(i) = P(i-2) + P(i-3)
        
        // Сдвигаем значения для следующего шага
        p0 = p1;
        p1 = p2;
        p2 = pn;
    }
    
    return pn;
}

int main() {
    int n;
    
    printf("Введите номер числа Перрина (n >= 0): ");
    if (scanf("%d", &n) != 1 || n < 0) {
        printf("Ошибка ввода! Введите неотрицательное целое число.\n");
        return 1;
    }

    // Вызов функций
    long long res_rec = perrin_recursive(n);
    long long res_ite = perrin_iterative(n);

    // Вывод результатов
    printf("\n--- Результаты для n = %d ---\n", n);
    printf("Рекурсивно:  %lld\n", res_rec);
    printf("Итеративно:  %lld\n", res_ite);

    // Сравнение
    if (res_rec == res_ite) {
        printf("\nРезультаты совпадают! :)\n");
    } else {
        printf("\nОшибка: результаты не совпадают!\n");
    }

    return 0;
}
