//Программа реализует архитектуру Фон Неймана:
//Единое хранилище для комманд и данных в массиве memory[MEM_SIZE]
//Цикл while управляется счетчиком команд и выполняется последовательно
//Наличие АЛУ и использование массива cpu_state[] в роли регистров процессора
//Вектор прерываний - при ошибке управление передается по адресу из memory[0]

#include <stdio.h>

#define MEM_SIZE 256

int main(void) {
    int cpu_state[8];
    int memory[MEM_SIZE];

    int n;          // количество чисел, прочитанных из файла 
    int pc;         // счётчик команд 
    int acc;        // аккумулятор 
    int ir;         // регистр команд
    int operand;    // операнд текущей команды

    n = 0;
    while (n < MEM_SIZE && scanf("%d", &memory[n]) == 1) {
        n++;
    }

    cpu_state[0] = 6;              // pc: первая команда начинается с ячейки 6 
    cpu_state[1] = 0;              // acc 
    cpu_state[2] = 0;              // ir
    cpu_state[3] = memory[0];      // вектор прерываний = memory[0] 
    cpu_state[4] = 0;              // флаг остановки 
    cpu_state[5] = 0;              // код ошибки
    cpu_state[6] = 0;              // резерв
    cpu_state[7] = 0;              // резерв

    pc = cpu_state[0];
    acc = cpu_state[1];

    while (cpu_state[4] == 0) {
        // Проверка выхода за границы памяти
        if (pc < 0 || pc >= MEM_SIZE) {
            printf("pc=%d: ОШИБКА: выход за границы памяти\n", pc);
            cpu_state[5] = 2;
            pc = cpu_state[3];
            acc = cpu_state[1];
            cpu_state[4] = 1;
            printf("Программа завершена с ошибкой.\n");
            break;
        }

        ir = memory[pc];
        cpu_state[2] = ir;

        if (ir == 0) {
            printf("pc=%d: команда 0, acc=%d\n", pc, acc);
            cpu_state[4] = 1;
            break;
        }

        if (ir == 1 || ir == 2 || ir == 3 || ir == 4 || ir == 5) {
            if (pc + 1 >= MEM_SIZE) {
                printf("pc=%d: ОШИБКА: операнд за границей памяти\n", pc);
                cpu_state[5] = 2;
                pc = cpu_state[3];
                acc = cpu_state[1];
                cpu_state[4] = 1;
                printf("Программа завершена с ошибкой.\n");
                break;
            }
            operand = memory[pc + 1];

            if (ir == 1) { //LOAD
                if (operand < 0 || operand >= MEM_SIZE) {
                    printf("pc=%d: команда 1 (LOAD), operand=%d, ОШИБКА: адрес вне памяти\n", pc, operand);
                    cpu_state[5] = 2;
                    pc = cpu_state[3];
                    acc = cpu_state[1];
                    cpu_state[4] = 1;
                    printf("Программа завершена с ошибкой.\n");
                    break;
                }
                acc = memory[operand];
                pc += 2;
                printf("pc=%d: команда 1 (LOAD), operand=%d, acc=%d\n", pc - 2, operand, acc);
            }
            else if (ir == 2) { //MUL
                if (operand < 0 || operand >= MEM_SIZE) {
                    printf("pc=%d: команда 2 (MUL), operand=%d, ОШИБКА: адрес вне памяти\n", pc, operand);
                    cpu_state[5] = 2;
                    pc = cpu_state[3];
                    acc = cpu_state[1];
                    cpu_state[4] = 1;
                    printf("Программа завершена с ошибкой.\n");
                    break;
                }
                acc = acc * memory[operand];
                pc += 2;
                printf("pc=%d: команда 2 (MUL), operand=%d, acc=%d\n", pc - 2, operand, acc);
            }
            else if (ir == 3) { //DIV
                if (operand < 0 || operand >= MEM_SIZE) {
                    printf("pc=%d: команда 3 (DIV), operand=%d, ОШИБКА: адрес вне памяти\n", pc, operand);
                    cpu_state[5] = 2;
                    pc = cpu_state[3];
                    acc = cpu_state[1];
                    cpu_state[4] = 1;
                    printf("Программа завершена с ошибкой.\n");
                    break;
                }
                if (memory[operand] == 0) {
                    printf("pc=%d: команда 3 (DIV), operand=%d, ОШИБКА: деление на 0\n", pc, operand);
                    cpu_state[5] = 1;
                    pc = cpu_state[3];
                    acc = cpu_state[1];
                    cpu_state[4] = 1;
                    printf("Программа завершена с ошибкой.\n");
                    break;
                }
                acc = acc / memory[operand];
                pc += 2;
                printf("pc=%d: команда 3 (DIV), operand=%d, acc=%d\n", pc - 2, operand, acc);
            }
            else if (ir == 4) { //JUMP
                if (operand < 0 || operand >= MEM_SIZE) {
                    printf("pc=%d: команда 4 (JUMP), operand=%d, ОШИБКА: адрес перехода вне памяти\n", pc, operand);
                    cpu_state[5] = 2;
                    pc = cpu_state[3];
                    acc = cpu_state[1];
                    cpu_state[4] = 1;
                    printf("Программа завершена с ошибкой.\n");
                    break;
                }
                printf("pc=%d: команда 4 (JUMP), operand=%d, acc=%d\n", pc, operand, acc);
                pc = operand;
            }
            else if (ir == 5) { //JZ
                if (operand < 0 || operand >= MEM_SIZE) {
                    printf("pc=%d: команда 5 (JZ), operand=%d, ОШИБКА: адрес перехода вне памяти\n", pc, operand);
                    cpu_state[5] = 2;
                    pc = cpu_state[3];
                    acc = cpu_state[1];
                    cpu_state[4] = 1;
                    printf("Программа завершена с ошибкой.\n");
                    break;
                }
                if (acc == 0) {
                    printf("pc=%d: команда 5 (JZ), operand=%d, acc=%d -> переход\n",
                           pc, operand, acc);
                    pc = operand;
                } else {
                    printf("pc=%d: команда 5 (JZ), operand=%d, acc=%d -> без перехода\n",
                           pc, operand, acc);
                    pc += 2;
                }
            }
        }
        else {
            printf("pc=%d: ОШИБКА: неизвестная команда %d\n", pc, ir);
            cpu_state[5] = 3;
            pc = cpu_state[3];
            acc = cpu_state[1];
            cpu_state[4] = 1;
            printf("Программа завершена с ошибкой.\n");
            break;
        }
        cpu_state[0] = pc;
        cpu_state[1] = acc;
    }

    if (cpu_state[5] == 0 && cpu_state[4] == 1) {
        printf("Программа успешно завершена.\n");
    }

    return 0;
}
